{
  "name": "chinese-checkers-online",
  "version": "1.0.0",
  "description": "改版跳棋 - 支持2-6人在线对战/PvE人机对战",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "esbuild src/index.js --bundle --format=esm --outfile=public/_worker.js --minify",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute chinese-checkers-db --file=./schema.sql",
    "db:init:local": "wrangler d1 execute chinese-checkers-db --local --file=./schema.sql"
  },
  "devDependencies": {
    "esbuild": "^0.27.3",
    "wrangler": "^3.80.0"
  }
}
